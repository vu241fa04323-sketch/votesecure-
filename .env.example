# ========================================================
# VoteSecure - Environment Variables Configuration Template
# ========================================================

# BACKEND CONFIGURATION (server/.env)
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/votesecure?retryWrites=true&w=majority
# Note: In development, if MONGODB_URI is left empty, the server automatically starts an in-memory MongoDB instance
MONGODB_URI=mongodb+srv://admin:securepassword@cluster0.mongodb.net/votesecure?retryWrites=true&w=majority

# JWT Authentication Secret Key (minimum 32 characters recommended for production)
JWT_SECRET=super_secret_jwt_key_votesecure_2026_secure_tokens

# JWT Expiration Period
JWT_EXPIRE=24h

# Allowed Client Origin for CORS
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials (auto-seeded on first server boot if no admin exists)
ADMIN_DEFAULT_NAME=System Administrator
ADMIN_DEFAULT_EMAIL=admin@votesecure.org
ADMIN_DEFAULT_PASSWORD=Admin@Secure2026!

# FRONTEND CONFIGURATION (client/.env)
# VITE_API_URL=http://localhost:5000/api
